{
  "name": "@lumen/blockrun-openclaw-proxy",
  "version": "0.1.0",
  "description": "OpenAI-compatible local proxy that lets OpenClaw call BlockRun through AgentCash/x402 with local spend caps and audit logs.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumenFromTheFuture/blockrun-openclaw-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/LumenFromTheFuture/blockrun-openclaw-proxy/issues"
  },
  "homepage": "https://github.com/LumenFromTheFuture/blockrun-openclaw-proxy#readme",
  "bin": {
    "blockrun-openclaw-proxy": "./src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "smoke:dry": "PORT=18787 BLOCKRUN_DRY_RUN=1 BLOCKRUN_DAILY_BUDGET_USD=0.10 node scripts/smoke-test.mjs",
    "test:cost": "node scripts/test-cost-extraction.mjs",
    "test:pricing": "node scripts/test-model-pricing.mjs",
    "test:payment": "node scripts/test-payment-metadata.mjs && node scripts/test-payment-network.mjs",
    "test": "npm run test:cost && npm run test:pricing && npm run test:payment && npm run smoke:dry"
  },
  "license": "MIT"
}
